{
    "name": "componenta/cqrs-retry",
    "description": "Retry middleware for Componenta CQRS commands",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.5.13",
        "componenta/config": "^4.0",
        "componenta/cqrs": "^5.0",
        "psr/container": "^2.0"
    },
    "require-dev": {
        "pestphp/pest": "^4.0",
        "phpstan/phpstan": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "Componenta\\CQRS\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Componenta\\CQRS\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "extra": {
        "branch-alias": {
            "dev-main": "4.0.x-dev",
            "dev-spec/attribute-callbacks-2026-11-26": "4.0.x-dev"
        },
        "componenta": {
            "config-providers": [
                "Componenta\\CQRS\\Retry\\ConfigProvider"
            ]
        }
    },
    "prefer-stable": true,
    "scripts": {
        "test": "@php vendor/bin/pest",
        "analyse": "@php vendor/bin/phpstan analyse src --level=max"
    }
}
